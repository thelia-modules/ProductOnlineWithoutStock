{% set domain = 'productonlinewithoutstock' %}
{% set list_url = '/admin/module/ProductOnlineWithoutStock' %}
{% set can_update = is_granted('UPDATE', 'admin.product') %}

{% macro sort_header(label, order, current_order, list_url) %}
    {% set is_asc = current_order == order %}
    {% set is_desc = current_order == order ~ '_reverse' %}
    <a href="{{ list_url }}?product_order={{ is_asc ? order ~ '_reverse' : order }}" class="text-decoration-none">
        {{ label }}
        {% if is_asc %}<i class="bi bi-caret-up-fill" aria-hidden="true"></i>{% elseif is_desc %}<i class="bi bi-caret-down-fill" aria-hidden="true"></i>{% endif %}
    </a>
{% endmacro %}

<div class="card">
    <div class="card-header">
        {{ '%count% product(s) online without stock'|trans({'%count%': total_count}, domain) }}
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>{{ _self.sort_header('ID'|trans({}, domain), 'id', order, list_url) }}</th>
                    <th>{{ _self.sort_header('Reference'|trans({}, domain), 'ref', order, list_url) }}</th>
                    <th>&nbsp;</th>
                    <th>{{ 'Product title'|trans({}, domain) }}</th>
                    <th>{{ 'Visibility'|trans({}, domain) }}</th>
                    <th class="text-end">{{ 'Actions'|trans({}, domain) }}</th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                {% set edit_url = path('admin.products.update', {product_id: item.id}) %}
                <tr>
                    <td>{{ item.id }}</td>
                    <td>
                        {% if can_update %}<a href="{{ edit_url }}" title="{{ 'Edit this product'|trans({}, domain) }}">{{ item.ref }}</a>{% else %}{{ item.ref }}{% endif %}
                    </td>
                    <td>
                        {% for image in loop('productonlinewithoutstock-image-' ~ item.id, 'image', {product: item.id, limit: 1, width: 50, height: 50, resize_mode: 'crop', backend_context: true}) %}
                            <img src="{{ image.IMAGE_URL }}" alt="{{ item.title }}" width="50" height="50" loading="lazy">
                        {% endfor %}
                    </td>
                    <td>{{ item.title }}</td>
                    <td>
                        {% if can_update %}
                            <form method="post" action="{{ path('productonlinewithoutstock.toggle-visibility') }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ assignToken() }}">
                                <input type="hidden" name="product_id" value="{{ item.id }}">
                                <input type="hidden" name="page" value="{{ current_page }}">
                                <input type="hidden" name="product_order" value="{{ order }}">
                                <button type="submit" class="btn btn-sm {{ item.visible ? 'btn-success' : 'btn-outline-danger' }}" title="{{ (item.visible ? 'Put offline' : 'Put online')|trans({}, domain) }}">
                                    <i class="bi {{ item.visible ? 'bi-toggle-on' : 'bi-toggle-off' }}" aria-hidden="true"></i>
                                    {{ (item.visible ? 'Online' : 'Offline')|trans({}, domain) }}
                                </button>
                            </form>
                        {% else %}
                            <span class="badge {{ item.visible ? 'bg-success' : 'bg-danger' }}">{{ (item.visible ? 'Online' : 'Offline')|trans({}, domain) }}</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        {% if can_update %}
                            <a class="btn btn-sm btn-outline-secondary" title="{{ 'Edit this product'|trans({}, domain) }}" href="{{ edit_url }}"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center py-3">{{ 'No products found'|trans({}, domain) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if total_pages > 1 %}
    {% set window_start = max(1, current_page - 4) %}
    {% set window_end = min(total_pages, current_page + 4) %}
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            {% if current_page > 1 %}
                <li class="page-item"><a class="page-link" href="{{ list_url }}?product_order={{ order }}&amp;page=1">&laquo;</a></li>
                <li class="page-item"><a class="page-link" href="{{ list_url }}?product_order={{ order }}&amp;page={{ current_page - 1 }}">&lsaquo;</a></li>
            {% endif %}
            {% for p in window_start..window_end %}
                <li class="page-item {{ p == current_page ? 'active' : '' }}"><a class="page-link" href="{{ list_url }}?product_order={{ order }}&amp;page={{ p }}">{{ p }}</a></li>
            {% endfor %}
            {% if current_page < total_pages %}
                <li class="page-item"><a class="page-link" href="{{ list_url }}?product_order={{ order }}&amp;page={{ current_page + 1 }}">&rsaquo;</a></li>
                <li class="page-item"><a class="page-link" href="{{ list_url }}?product_order={{ order }}&amp;page={{ total_pages }}">&raquo;</a></li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
